---
import BaseLayout from "../layouts/BaseLayout.astro";

import Header from "../components/Header.astro";
import PageHero from "../components/PageHero.astro";
import MissionVision from "../components/MissionVision.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";

const milestones = [
  {
    date: "21 OCT 2024",
    year: "2024",
    title: "Nace la idea",
    description:
      "Se plantea la creación de un círculo de estudios que responda a las necesidades académicas de la comunidad estudiantil.",
  },
  {
    date: "04 NOV 2024",
    year: "2024",
    title: "Se forma el primer grupo",
    description:
      "Estudiantes de distintos años académicos empiezan a trabajar en propuestas para construir el nuevo círculo.",
  },
  {
    date: "20 DIC 2024",
    year: "2024",
    title: "Se definen los ejes",
    description:
      "Las reuniones permiten consolidar democracia, partidos políticos y cultura política como los ejes temáticos de CIDEPAC.",
  },
  {
    date: "18 ENE 2025",
    year: "2025",
    title: "Fundación de CIDEPAC",
    description:
      "Se formaliza la creación del círculo de estudios y se elige democráticamente su primera junta directiva.",
  },
  {
    date: "2025 — 2026",
    year: "2026",
    title: "Crecemos y nos articulamos",
    description:
      "CIDEPAC amplía sus actividades académicas, debates, talleres, alianzas y espacios de participación dentro y fuera de la universidad.",
  },
];

const axes = [
  {
    number: "01",
    title: "Democracia",
    description:
      "Estudio, análisis y reflexión sobre democracia, ciudadanía y participación.",
  },
  {
    number: "02",
    title: "Partidos políticos",
    description:
      "Análisis de los actores, organizaciones y dinámicas de representación política.",
  },
  {
    number: "03",
    title: "Cultura política",
    description:
      "Reflexión sobre valores, percepciones y prácticas que forman nuestra relación con la política.",
  },
];

const organization = [
  {
    number: "01",
    title: "Junta Directiva",
    description:
      "Articula la dirección general y el funcionamiento institucional de CIDEPAC.",
  },
  {
    number: "02",
    title: "Investigación Académica",
    description:
      "Impulsa la producción y difusión de contenidos académicos y espacios de formación.",
  },
  {
    number: "03",
    title: "Medios y Diseño Digital",
    description:
      "Gestiona la comunicación y la identidad visual de la organización.",
  },
  {
    number: "04",
    title: "Logística y Economía",
    description:
      "Apoya la organización operativa y económica de las actividades.",
  },
  {
    number: "05",
    title: "Talento y Relaciones Institucionales",
    description:
      "Fortalece la comunidad interna y la articulación con otras organizaciones.",
  },
];
---

<BaseLayout
  title="Nosotros | CIDEPAC"
  description="Conoce la historia, misión, visión, ejes temáticos y organización del Círculo de Estudios CIDEPAC de la Universidad Nacional de Trujillo."
>
  <Header />

  <main>
    <!-- HERO -->
    <PageHero
      number="01"
      eyebrow="Nosotros"
      title="Una comunidad que piensa,"
      accent="cuestiona y participa."
      description="CIDEPAC es un espacio académico estudiantil dedicado al estudio, análisis y reflexión crítica sobre democracia, partidos políticos, cultura política y los desafíos de la gobernabilidad."
    />

    <!-- QUÉ ES CIDEPAC -->
    <section class="bg-white py-20 lg:py-24">
      <div
        class="site-container grid gap-14 lg:grid-cols-[0.75fr_1.25fr] lg:gap-24"
      >
        <div>
          <p
            class="text-xs font-extrabold uppercase tracking-[0.17em] text-cidepac-700"
          >
            Sobre CIDEPAC
          </p>

          <h2
            class="display-title mt-5 text-[3rem] leading-[0.95] text-neutral-950 sm:text-[3.7rem]"
          >
            Más que un
            <span class="text-cidepac-700">círculo de estudios.</span>
          </h2>
        </div>

        <div class="max-w-[720px]">
          <p class="text-lg leading-9 text-neutral-700">
            El Círculo de Estudios en Democracia, Partidos Políticos y Cultura
            Política — CIDEPAC — fue fundado el 18 de enero de 2025 por
            estudiantes de la Escuela Profesional de Ciencia Política y
            Gobernabilidad de la Universidad Nacional de Trujillo.
          </p>

          <p class="mt-6 text-base leading-8 text-neutral-600">
            Nace con el propósito de fortalecer la formación académica e
            investigativa mediante espacios de estudio, debate, reflexión,
            participación y cooperación universitaria.
          </p>

          <div
            class="mt-10 grid gap-px overflow-hidden border border-[#eaded9] bg-[#eaded9] sm:grid-cols-3"
          >
            <div class="bg-[#faf6f3] p-6">
              <p
                class="display-title text-[2rem] leading-none text-cidepac-700"
              >
                2025
              </p>

              <p class="mt-3 text-xs font-semibold text-neutral-500">
                Año de fundación
              </p>
            </div>

            <div class="bg-[#faf6f3] p-6">
              <p
                class="display-title text-[2rem] leading-none text-cidepac-700"
              >
                3
              </p>

              <p class="mt-3 text-xs font-semibold text-neutral-500">
                Ejes temáticos
              </p>
            </div>

            <div class="bg-[#faf6f3] p-6">
              <p
                class="display-title text-[2rem] leading-none text-cidepac-700"
              >
                UNT
              </p>

              <p class="mt-3 text-xs font-semibold text-neutral-500">
                Universidad Nacional de Trujillo
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- HISTORIA -->
    <section
      id="historia"
      class="border-t border-[#eaded9] bg-[#faf6f3] py-20 lg:py-24"
    >
      <div class="site-container">
        <div class="mb-14">
          <div class="mb-6 flex items-center gap-4">
            <span class="font-display text-xl text-cidepac-700">
              02
            </span>

            <span class="h-px w-7 bg-cidepac-700/40"></span>

            <span
              class="text-xs font-extrabold uppercase tracking-[0.16em] text-neutral-700"
            >
              Nuestra historia
            </span>
          </div>

          <h2
            class="display-title max-w-[760px] text-[3rem] leading-[0.95] text-neutral-950 sm:text-[3.8rem] lg:text-[4.5rem]"
          >
            De una idea estudiantil
            <span class="text-cidepac-700">a una comunidad.</span>
          </h2>
        </div>

        <div class="border-t border-[#d9ccc7]">
          {
            milestones.map((item) => (
              <article
                class="group grid gap-5 border-b border-[#d9ccc7] py-8 md:grid-cols-[150px_1fr_1.2fr] md:items-start"
              >
                <p
                  class="text-[0.7rem] font-extrabold uppercase tracking-[0.15em] text-cidepac-700"
                >
                  {item.date}
                </p>

                <h3
                  class="display-title text-[1.8rem] leading-none text-neutral-950 transition-colors group-hover:text-cidepac-700"
                >
                  {item.title}
                </h3>

                <p class="max-w-[620px] text-sm leading-6 text-neutral-600">
                  {item.description}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- MISIÓN / VISIÓN -->
    <MissionVision />

    <!-- EJES -->
    <section class="bg-white py-20 lg:py-24">
      <div class="site-container">
        <div class="mb-12">
          <div class="mb-6 flex items-center gap-4">
            <span class="font-display text-xl text-cidepac-700">
              03
            </span>

            <span class="h-px w-7 bg-cidepac-700/40"></span>

            <span
              class="text-xs font-extrabold uppercase tracking-[0.16em] text-neutral-700"
            >
              Nuestros ejes
            </span>
          </div>

          <h2
            class="display-title max-w-[760px] text-[3rem] leading-[0.95] text-neutral-950 sm:text-[3.8rem]"
          >
            Tres ejes.
            <span class="text-cidepac-700">Una misma conversación.</span>
          </h2>
        </div>

        <div class="grid border-y border-[#ded2ce] md:grid-cols-3">
          {
            axes.map((axis, index) => (
              <article
                class:list={[
                  "py-9 md:px-8 lg:px-10",
                  index !== 0 &&
                    "border-t border-[#ded2ce] md:border-l md:border-t-0",
                ]}
              >
                <p
                  class="text-xs font-extrabold tracking-[0.15em] text-cidepac-700"
                >
                  {axis.number}
                </p>

                <h3
                  class="display-title mt-3 text-[2rem] leading-none text-neutral-950"
                >
                  {axis.title}
                </h3>

                <p class="mt-5 max-w-[310px] text-sm leading-6 text-neutral-600">
                  {axis.description}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ORGANIZACIÓN -->
    <section class="border-t border-[#eaded9] bg-[#faf6f3] py-20 lg:py-24">
      <div class="site-container">
        <div
          class="mb-12 grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-end"
        >
          <div>
            <div class="mb-6 flex items-center gap-4">
              <span class="font-display text-xl text-cidepac-700">
                04
              </span>

              <span class="h-px w-7 bg-cidepac-700/40"></span>

              <span
                class="text-xs font-extrabold uppercase tracking-[0.16em] text-neutral-700"
              >
                Cómo nos organizamos
              </span>
            </div>

            <h2
              class="display-title text-[3rem] leading-[0.95] text-neutral-950 sm:text-[3.8rem]"
            >
              Una organización
              <span class="text-cidepac-700">hecha por estudiantes.</span>
            </h2>
          </div>

          <p
            class="max-w-[630px] text-base leading-8 text-neutral-600 lg:justify-self-end"
          >
            CIDEPAC articula su trabajo mediante una Junta Directiva y
            comisiones especializadas que permiten desarrollar sus actividades
            académicas, institucionales y de proyección.
          </p>
        </div>

        <div class="border-t border-[#d9ccc7]">
          {
            organization.map((area) => (
              <article
                class="group grid gap-4 border-b border-[#d9ccc7] py-7 md:grid-cols-[70px_0.8fr_1.2fr] md:items-center"
              >
                <span
                  class="font-display text-xl text-cidepac-700"
                  aria-hidden="true"
                >
                  {area.number}
                </span>

                <h3
                  class="display-title text-[1.7rem] leading-none text-neutral-950 transition-colors group-hover:text-cidepac-700"
                >
                  {area.title}
                </h3>

                <p class="max-w-[600px] text-sm leading-6 text-neutral-600">
                  {area.description}
                </p>
              </article>
            ))
          }
        </div>

        <a
          href="/comisiones"
          class="focus-ring mt-8 inline-flex items-center gap-2 rounded-sm text-sm font-extrabold text-cidepac-700 transition hover:gap-3"
        >
          Conoce nuestras comisiones
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <FinalCTA />
  </main>

  <Footer />
</BaseLayout>