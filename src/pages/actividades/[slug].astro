---
import BaseLayout from "../../layouts/BaseLayout.astro";

import Header from "../../components/Header.astro";
import ActivityCard from "../../components/ActivityCard.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import Footer from "../../components/Footer.astro";

import { activities, type Activity } from "../../data/activities";

export function getStaticPaths() {
  return activities.map((activity, index) => {
    const previousActivity = index > 0 ? activities[index - 1] : undefined;
    const nextActivity =
      index < activities.length - 1 ? activities[index + 1] : undefined;

    const sameYearActivities = activities.filter(
      (candidate) =>
        candidate.id !== activity.id && candidate.year === activity.year,
    );

    const nearbyActivities = activities.filter(
      (candidate) =>
        candidate.id !== activity.id &&
        !sameYearActivities.some((sameYear) => sameYear.id === candidate.id),
    );

    return {
      params: { slug: activity.slug },
      props: {
        activity,
        previousActivity,
        nextActivity,
        relatedActivities: [...sameYearActivities, ...nearbyActivities].slice(
          0,
          3,
        ),
      },
    };
  });
}

interface Props {
  activity: Activity;
  previousActivity?: Activity;
  nextActivity?: Activity;
  relatedActivities: Activity[];
}

const { activity, previousActivity, nextActivity, relatedActivities } =
  Astro.props;

const gallery = activity.gallery ?? [];
const hasGallery = gallery.length > 0;
const galleryGridClass =
  gallery.length >= 3 ? "md:grid-cols-2 xl:grid-cols-3" : "md:grid-cols-2";
---

<BaseLayout
  title={`${activity.title} | CIDEPAC`}
  description={activity.description}
  image={activity.image}
>
  <Header />

  <main>
    <section class="bg-[#faf6f3]">
      <div class="site-container py-7">
        <nav
          aria-label="Breadcrumb"
          class="flex flex-wrap items-center gap-2 text-xs font-bold text-neutral-500"
        >
          <a
            href="/"
            class="focus-ring rounded-sm transition hover:text-cidepac-700"
          >
            Inicio
          </a>

          <span aria-hidden="true">/</span>

          <a
            href="/actividades"
            class="focus-ring rounded-sm transition hover:text-cidepac-700"
          >
            Actividades
          </a>

          <span aria-hidden="true">/</span>

          <span class="text-cidepac-700" aria-current="page">
            {activity.title}
          </span>
        </nav>
      </div>
    </section>

    <section class="border-y border-[#eaded9] bg-white">
      <div
        class="site-container grid gap-10 py-14 lg:grid-cols-[0.92fr_1.08fr] lg:items-center lg:py-20"
      >
        <div>
          <div class="flex flex-wrap items-center gap-3">
            <span
              class="rounded-full bg-cidepac-700 px-4 py-2 text-[0.65rem] font-extrabold uppercase tracking-[0.14em] text-white"
            >
              {activity.year}
            </span>

            <span
              class="rounded-full border border-[#eaded9] px-4 py-2 text-[0.65rem] font-extrabold uppercase tracking-[0.14em] text-cidepac-700"
            >
              {activity.modality}
            </span>
          </div>

          <h1
            class="display-title mt-7 max-w-[760px] text-[3.4rem] leading-[0.92] text-neutral-950 sm:text-[4.5rem] lg:text-[5.4rem]"
          >
            {activity.title}
          </h1>

          <dl class="mt-8 grid gap-5 border-t border-[#eaded9] pt-7">
            <div>
              <dt
                class="text-[0.68rem] font-extrabold uppercase tracking-[0.14em] text-neutral-400"
              >
                Fecha
              </dt>

              <dd class="mt-2 text-sm font-bold text-neutral-900">
                {activity.date}
              </dd>
            </div>

            <div>
              <dt
                class="text-[0.68rem] font-extrabold uppercase tracking-[0.14em] text-neutral-400"
              >
                Lugar
              </dt>

              <dd class="mt-2 text-sm font-bold leading-6 text-neutral-900">
                {activity.place}
              </dd>
            </div>
          </dl>
        </div>

        <div class="relative aspect-[16/10] overflow-hidden bg-[#eee8e5]">
          {
            activity.image ? (
              <img
                src={activity.image}
                alt={`Imagen principal de la actividad ${activity.title}`}
                class="absolute inset-0 h-full w-full object-cover"
              />
            ) : (
              <div class="absolute inset-0 grid place-items-center bg-[linear-gradient(135deg,#f5efec,#e6ddda)]">
                <div class="text-center text-neutral-300">
                  <svg
                    class="mx-auto"
                    width="62"
                    height="62"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                    aria-hidden="true"
                  >
                    <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                    <circle cx="8.5" cy="9" r="1.5"></circle>
                    <path d="m21 15-5-5L5 20"></path>
                  </svg>

                  <p
                    class="mt-4 text-[0.65rem] font-extrabold uppercase tracking-[0.18em]"
                  >
                    Imagen de actividad
                  </p>
                </div>
              </div>
            )
          }

          <span
            class="absolute bottom-0 right-0 size-20 bg-cidepac-orange sm:size-24"
            aria-hidden="true"
          ></span>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 lg:py-20">
      <div class="site-container grid gap-12 lg:grid-cols-[0.72fr_1.28fr]">
        <div>
          <p
            class="text-xs font-extrabold uppercase tracking-[0.17em] text-cidepac-700"
          >
            Descripción
          </p>

          <h2
            class="display-title mt-5 text-[2.8rem] leading-[0.96] text-neutral-950 sm:text-[3.5rem]"
          >
            Sobre la actividad
          </h2>
        </div>

        <div>
          <p class="max-w-[760px] text-base leading-8 text-neutral-600">
            {activity.description}
          </p>
        </div>
      </div>
    </section>

    <section class="border-y border-[#eaded9] bg-[#faf6f3] py-16 lg:py-20">
      <div class="site-container">
        <div class="mb-10 flex items-center gap-4">
          <span class="font-display text-xl text-cidepac-700">
            01
          </span>

          <span class="h-px w-7 bg-cidepac-700/40"></span>

          <h2
            class="text-xs font-extrabold uppercase tracking-[0.16em] text-neutral-700"
          >
            Información
          </h2>
        </div>

        <dl class="grid gap-5 md:grid-cols-3">
          <div class="border border-[#eaded9] bg-white p-6">
            <dt
              class="text-[0.68rem] font-extrabold uppercase tracking-[0.14em] text-neutral-400"
            >
              Fecha
            </dt>

            <dd class="mt-3 text-sm font-bold leading-6 text-neutral-900">
              {activity.date}
            </dd>
          </div>

          <div class="border border-[#eaded9] bg-white p-6">
            <dt
              class="text-[0.68rem] font-extrabold uppercase tracking-[0.14em] text-neutral-400"
            >
              Lugar
            </dt>

            <dd class="mt-3 text-sm font-bold leading-6 text-neutral-900">
              {activity.place}
            </dd>
          </div>

          <div class="border border-[#eaded9] bg-white p-6">
            <dt
              class="text-[0.68rem] font-extrabold uppercase tracking-[0.14em] text-neutral-400"
            >
              Modalidad
            </dt>

            <dd class="mt-3 text-sm font-bold leading-6 text-neutral-900">
              {activity.modality}
            </dd>
          </div>
        </dl>
      </div>
    </section>

    {
      hasGallery && (
        <section class="bg-white py-16 lg:py-20">
          <div class="site-container">
            <div class="mb-10 flex items-center gap-4">
              <span class="font-display text-xl text-cidepac-700">02</span>

              <span class="h-px w-7 bg-cidepac-700/40"></span>

              <h2 class="text-xs font-extrabold uppercase tracking-[0.16em] text-neutral-700">
                Galería
              </h2>
            </div>

            <div class:list={["grid gap-5", galleryGridClass]}>
              {gallery.map((image, index) => (
                <figure class="overflow-hidden border border-[#eaded9] bg-[#eee8e5]">
                  <div class="relative aspect-[16/10]">
                    <img
                      src={image}
                      alt={`Galería de la actividad ${activity.title} ${index + 1}`}
                      loading="lazy"
                      class="absolute inset-0 h-full w-full object-cover"
                    />
                  </div>
                </figure>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      (previousActivity || nextActivity) && (
        <section class="border-y border-[#eaded9] bg-[#faf6f3] py-10">
          <div class="site-container flex flex-col gap-4 sm:flex-row sm:items-stretch sm:justify-between">
            {previousActivity && (
              <a
                href={`/actividades/${previousActivity.slug}`}
                class="focus-ring group border border-[#eaded9] bg-white p-5 transition hover:border-cidepac-700/35 sm:max-w-[48%]"
              >
                <span class="text-[0.65rem] font-extrabold uppercase tracking-[0.14em] text-neutral-400">
                  Anterior
                </span>

                <span class="mt-2 block text-sm font-extrabold text-neutral-900 transition group-hover:text-cidepac-700">
                  {previousActivity.title}
                </span>
              </a>
            )}

            {nextActivity && (
              <a
                href={`/actividades/${nextActivity.slug}`}
                class="focus-ring group border border-[#eaded9] bg-white p-5 transition hover:border-cidepac-700/35 sm:ml-auto sm:max-w-[48%] sm:text-right"
              >
                <span class="text-[0.65rem] font-extrabold uppercase tracking-[0.14em] text-neutral-400">
                  Siguiente
                </span>

                <span class="mt-2 block text-sm font-extrabold text-neutral-900 transition group-hover:text-cidepac-700">
                  {nextActivity.title}
                </span>
              </a>
            )}
          </div>
        </section>
      )
    }

    <section class="bg-white py-16 lg:py-20">
      <div class="site-container">
        <div
          class="mb-10 flex flex-col justify-between gap-6 md:flex-row md:items-end"
        >
          <div>
            <p
              class="text-xs font-extrabold uppercase tracking-[0.17em] text-cidepac-700"
            >
              Más actividades
            </p>

            <h2
              class="display-title mt-5 text-[2.8rem] leading-[0.96] text-neutral-950 sm:text-[3.5rem]"
            >
              También te puede interesar
            </h2>
          </div>
        </div>

        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {
            relatedActivities.map((relatedActivity) => (
              <ActivityCard activity={relatedActivity} />
            ))
          }
        </div>
      </div>
    </section>

    <FinalCTA />
  </main>

  <Footer />
</BaseLayout>
