---
import { getCollection, render, type CollectionEntry } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";

import Header from "../../components/Header.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import Footer from "../../components/Footer.astro";

import {
  getArticleSlug,
  sortArticles,
  toArticleCardData,
} from "../../lib/articles";

type ArticleEntry = CollectionEntry<"articles">;

export async function getStaticPaths() {
  const articles = (
    await getCollection("articles", ({ data }) => !data.draft)
  ).sort(sortArticles);

  return articles.map((article, index) => {
    const sameTypeArticles = articles.filter(
      (candidate) =>
        candidate.id !== article.id && candidate.data.type === article.data.type,
    );

    const otherArticles = articles.filter(
      (candidate) =>
        candidate.id !== article.id &&
        !sameTypeArticles.some((sameType) => sameType.id === candidate.id),
    );

    return {
      params: { slug: getArticleSlug(article) },
      props: {
        article,
        previousArticle: index > 0 ? articles[index - 1] : undefined,
        nextArticle: index < articles.length - 1 ? articles[index + 1] : undefined,
        relatedArticles: [...sameTypeArticles, ...otherArticles].slice(0, 3),
      },
    };
  });
}

interface Props {
  article: ArticleEntry;
  previousArticle?: ArticleEntry;
  nextArticle?: ArticleEntry;
  relatedArticles: ArticleEntry[];
}

const { article, previousArticle, nextArticle, relatedArticles } = Astro.props;
const { Content } = await render(article);

const hasBody = Boolean(article.body?.trim());
const description =
  article.data.summary ??
  `Publicación académica de CIDEPAC por ${article.data.author}.`;

const publishedAt = article.data.publishedAt
  ? new Intl.DateTimeFormat("es-PE", {
      day: "numeric",
      month: "long",
      year: "numeric",
    }).format(article.data.publishedAt)
  : undefined;
---

<BaseLayout
  title={`${article.data.title} | CIDEPAC`}
  description={description}
  image={article.data.image}
  ogType="article"
>
  <Header />

  <main>
    <article>
      <section class="bg-[#faf6f3]">
        <div class="site-container py-7">
          <nav
            aria-label="Breadcrumb"
            class="flex flex-wrap items-center gap-2 text-xs font-bold text-neutral-500"
          >
            <a
              href="/"
              class="focus-ring rounded-sm transition hover:text-cidepac-700"
            >
              Inicio
            </a>

            <span aria-hidden="true">/</span>

            <a
              href="/articulos"
              class="focus-ring rounded-sm transition hover:text-cidepac-700"
            >
              Artículos
            </a>

            <span aria-hidden="true">/</span>

            <span class="text-cidepac-700" aria-current="page">
              {article.data.title}
            </span>
          </nav>
        </div>
      </section>

      <header class="border-y border-[#eaded9] bg-white">
        <div class="site-container py-14 lg:py-20">
          <div class="mx-auto max-w-[920px]">
            <p
              class="text-xs font-extrabold uppercase tracking-[0.17em] text-cidepac-700"
            >
              {article.data.type}
            </p>

            <h1
              class="display-title mt-5 text-[3.2rem] leading-[0.94] text-neutral-950 sm:text-[4.3rem] lg:text-[5.1rem]"
            >
              {article.data.title}
            </h1>

            <div
              class="mt-8 flex flex-col gap-4 border-t border-[#eaded9] pt-6 text-sm text-neutral-600 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-8"
            >
              <p>
                Por <strong class="font-bold text-neutral-900">{article.data.author}</strong>
              </p>

              {
                publishedAt && (
                  <p>
                    Fecha:{" "}
                    <time datetime={article.data.publishedAt?.toISOString()}>
                      {publishedAt}
                    </time>
                  </p>
                )
              }

              {
                article.data.source && (
                  <p>
                    Fuente:{" "}
                    <span class="font-semibold text-neutral-800">
                      {article.data.source}
                    </span>
                  </p>
                )
              }
            </div>

            {
              article.data.summary && (
                <p class="mt-8 max-w-[760px] text-lg leading-9 text-neutral-600">
                  {article.data.summary}
                </p>
              )
            }
          </div>
        </div>
      </header>

      {
        article.data.image && (
          <section class="bg-[#faf6f3] py-10 lg:py-14">
            <div class="site-container">
              <figure class="mx-auto max-w-[980px] overflow-hidden border border-[#eaded9] bg-[#eee8e5]">
                <div class="relative aspect-[16/9]">
                  <img
                    src={article.data.image}
                    alt={`Portada de la publicación ${article.data.title}`}
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                </div>
              </figure>
            </div>
          </section>
        )
      }

      <section class="bg-white py-16 lg:py-20">
        <div class="site-container">
          <div class="mx-auto max-w-[760px]">
            {
              hasBody ? (
                <>
                  <div class="article-body">
                    <Content />
                  </div>

                  {article.data.externalUrl && (
                    <div class="mt-12 border-t border-[#eaded9] pt-8">
                      <a
                        href={article.data.externalUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="focus-ring inline-flex min-h-12 items-center justify-center gap-2 rounded-md border border-cidepac-700 px-6 text-sm font-extrabold text-cidepac-700 transition hover:bg-cidepac-700 hover:text-white"
                      >
                        Leer publicación original
                        <span aria-hidden="true">↗</span>
                        <span class="sr-only">abre en una pestaña nueva</span>
                      </a>
                    </div>
                  )}
                </>
              ) : (
                <section
                  aria-labelledby="fuente-original"
                  class="border border-[#eaded9] bg-[#faf6f3] p-7 sm:p-9"
                >
                  <h2
                    id="fuente-original"
                    class="display-title text-[2.2rem] leading-none text-neutral-950"
                  >
                    Fuente original
                  </h2>

                  <p class="mt-5 text-base leading-8 text-neutral-600">
                    Esta publicación se encuentra disponible en su fuente
                    original.
                  </p>

                  {article.data.externalUrl && (
                    <a
                      href={article.data.externalUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="focus-ring mt-7 inline-flex min-h-12 items-center justify-center gap-2 rounded-md bg-cidepac-700 px-6 text-sm font-extrabold text-white transition hover:bg-cidepac-900"
                    >
                      Leer publicación original
                      <span aria-hidden="true">↗</span>
                      <span class="sr-only">abre en una pestaña nueva</span>
                    </a>
                  )}
                </section>
              )
            }
          </div>
        </div>
      </section>
    </article>

    {
      (previousArticle || nextArticle) && (
        <section class="border-y border-[#eaded9] bg-[#faf6f3] py-10">
          <div class="site-container flex flex-col gap-4 sm:flex-row sm:items-stretch sm:justify-between">
            {previousArticle && (
              <a
                href={`/articulos/${getArticleSlug(previousArticle)}`}
                class="focus-ring group border border-[#eaded9] bg-white p-5 transition hover:border-cidepac-700/35 sm:max-w-[48%]"
              >
                <span class="text-[0.65rem] font-extrabold uppercase tracking-[0.14em] text-neutral-400">
                  ← Publicación anterior
                </span>

                <span class="mt-2 block text-sm font-extrabold text-neutral-900 transition group-hover:text-cidepac-700">
                  {previousArticle.data.title}
                </span>
              </a>
            )}

            {nextArticle && (
              <a
                href={`/articulos/${getArticleSlug(nextArticle)}`}
                class="focus-ring group border border-[#eaded9] bg-white p-5 transition hover:border-cidepac-700/35 sm:ml-auto sm:max-w-[48%] sm:text-right"
              >
                <span class="text-[0.65rem] font-extrabold uppercase tracking-[0.14em] text-neutral-400">
                  Publicación siguiente →
                </span>

                <span class="mt-2 block text-sm font-extrabold text-neutral-900 transition group-hover:text-cidepac-700">
                  {nextArticle.data.title}
                </span>
              </a>
            )}
          </div>
        </section>
      )
    }

    <section class="bg-white py-16 lg:py-20">
      <div class="site-container">
        <div class="mb-10">
          <p
            class="text-xs font-extrabold uppercase tracking-[0.17em] text-cidepac-700"
          >
            Publicaciones relacionadas
          </p>

          <h2
            class="display-title mt-5 text-[2.8rem] leading-[0.96] text-neutral-950 sm:text-[3.5rem]"
          >
            Más voces de CIDEPAC
          </h2>
        </div>

        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {
            relatedArticles.map((relatedArticle) => (
              <ArticleCard
                article={toArticleCardData(relatedArticle)}
                headingLevel="h3"
              />
            ))
          }
        </div>
      </div>
    </section>

    <FinalCTA />
  </main>

  <Footer />
</BaseLayout>
