---
import type { Activity } from "../data/activities";

interface Props {
  activity: Activity;
}

const { activity } = Astro.props;
---

<a
  href={`/actividades/${activity.slug}`}
  class="focus-ring group block overflow-hidden border border-[#eaded9] bg-white transition duration-300 hover:-translate-y-1 hover:border-cidepac-700/30 hover:shadow-[0_20px_50px_rgba(122,0,0,0.07)]"
>
  <article>
    <div class="relative aspect-[16/9] overflow-hidden bg-[#eee8e5]">
      {
        activity.image ? (
          <img
            src={activity.image}
            alt={`Imagen de la actividad ${activity.title}`}
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover"
          />
        ) : (
          <div class="absolute inset-0 grid place-items-center bg-[linear-gradient(135deg,#f5efec,#e6ddda)]">
            <svg
              width="42"
              height="42"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              class="text-neutral-300"
              aria-hidden="true"
            >
              <rect x="3" y="4" width="18" height="16" rx="2"></rect>
              <circle cx="8.5" cy="9" r="1.5"></circle>
              <path d="m21 15-5-5L5 20"></path>
            </svg>
          </div>
        )
      }

      <span
        class="absolute left-4 top-4 rounded-full bg-white/95 px-3 py-1.5 text-[0.62rem] font-extrabold uppercase tracking-[0.12em] text-cidepac-700"
      >
        {activity.year}
      </span>

      <span
        class="absolute bottom-0 right-0 size-8 bg-cidepac-orange"
        aria-hidden="true"
      ></span>
    </div>

    <div class="p-6">
      <p
        class="text-[0.67rem] font-extrabold uppercase tracking-[0.14em] text-cidepac-700"
      >
        {activity.modality}
      </p>

      <h2
        class="display-title mt-3 text-[1.75rem] leading-[1.02] text-neutral-950 transition-colors group-hover:text-cidepac-700"
      >
        {activity.title}
      </h2>

      <p class="mt-4 line-clamp-3 text-sm leading-6 text-neutral-600">
        {activity.description}
      </p>

      <div class="mt-7 border-t border-[#eaded9] pt-5">
        <p class="text-xs font-bold text-neutral-700">
          {activity.date}
        </p>

        <p class="mt-2 text-xs leading-5 text-neutral-400">
          {activity.place}
        </p>

        <div class="mt-5 flex items-center justify-between">
          <span
            class="text-[0.65rem] font-extrabold uppercase tracking-[0.13em] text-neutral-400 transition-colors group-hover:text-cidepac-700"
          >
            Ver actividad
          </span>

          <span
            class="grid size-9 place-items-center rounded-full border border-[#eaded9] text-cidepac-700 transition group-hover:border-cidepac-700 group-hover:bg-cidepac-700 group-hover:text-white"
            aria-hidden="true"
          >
            →
          </span>
        </div>
      </div>
    </div>
  </article>
</a>
