---
import type { Article } from "../data/articles";

interface Props {
  article: Article;
}

const { article } = Astro.props;
---

<a
  href={article.externalUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="focus-ring group block overflow-hidden border border-[#eaded9] bg-white transition duration-300 hover:-translate-y-1 hover:border-cidepac-700/30 hover:shadow-[0_20px_50px_rgba(122,0,0,0.07)]"
>
  <article>
    <div class="relative aspect-[16/9] overflow-hidden bg-[#eee8e5]">
      {
        article.image ? (
          <img
            src={article.image}
            alt={`Portada del artículo ${article.title}`}
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover"
          />
        ) : (
          <div class="absolute inset-0 grid place-items-center bg-[linear-gradient(135deg,#f5efec,#e5dcda)]">
            <svg
              width="42"
              height="42"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              class="text-neutral-300"
              aria-hidden="true"
            >
              <path d="M4 4h16v16H4z"></path>
              <path d="M8 8h8"></path>
              <path d="M8 12h8"></path>
              <path d="M8 16h5"></path>
            </svg>
          </div>
        )
      }

      <span
        class="absolute left-4 top-4 rounded-full bg-white/95 px-3 py-1.5 text-[0.62rem] font-extrabold uppercase tracking-[0.13em] text-cidepac-700"
      >
        {article.type}
      </span>

      <span
        class="absolute bottom-0 right-0 size-8 bg-cidepac-orange"
        aria-hidden="true"
      ></span>
    </div>

    <div class="flex min-h-[290px] flex-col justify-between p-6">
      <div>
        <p
          class="text-[0.65rem] font-extrabold uppercase tracking-[0.15em] text-cidepac-700"
        >
          Producción académica
        </p>

        <h2
          class="display-title mt-4 text-[1.75rem] leading-[1.04] text-neutral-950 transition-colors group-hover:text-cidepac-700"
        >
          {article.title}
        </h2>
      </div>

      <div class="mt-8 border-t border-[#eaded9] pt-5">
        <p class="text-sm font-semibold text-neutral-600">
          Por {article.author}
        </p>

        <div class="mt-5 flex items-center justify-between">
          <span
            class="text-[0.65rem] font-extrabold uppercase tracking-[0.13em] text-neutral-400 transition-colors group-hover:text-cidepac-700"
          >
            Leer en {article.source}
          </span>

          <span
            class="grid size-9 place-items-center rounded-full border border-[#eaded9] text-cidepac-700 transition group-hover:border-cidepac-700 group-hover:bg-cidepac-700 group-hover:text-white"
            aria-hidden="true"
          >
            ↗
          </span>
        </div>
      </div>
    </div>
  </article>
</a>
