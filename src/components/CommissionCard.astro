---
interface Props {
  number: string;
  title: string;
  description: string;
  icon: "direction" | "academic" | "media" | "logistics" | "talent";
}

const {
  number,
  title,
  description,
  icon,
} = Astro.props;

const icons = {
  direction: `
    <path d="M12 3 3 8l9 5 9-5-9-5Z"/>
    <path d="m3 12 9 5 9-5"/>
    <path d="m3 16 9 5 9-5"/>
  `,
  academic: `
    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/>
  `,
  media: `
    <rect x="3" y="5" width="18" height="14" rx="2"/>
    <path d="m10 9 5 3-5 3V9Z"/>
  `,
  logistics: `
    <path d="M3 6h13v11H3z"/>
    <path d="M16 10h3l2 3v4h-5z"/>
    <circle cx="7" cy="18" r="2"/>
    <circle cx="18" cy="18" r="2"/>
  `,
  talent: `
    <circle cx="9" cy="7" r="3"/>
    <circle cx="17" cy="8" r="2"/>
    <path d="M3 21v-2a6 6 0 0 1 12 0v2"/>
    <path d="M15 15a5 5 0 0 1 6 4v2"/>
  `,
};
---

<article
  class="group flex min-h-[360px] flex-col justify-between border border-[#eaded9] bg-white p-7 transition duration-300 hover:-translate-y-1 hover:border-cidepac-700/35 hover:shadow-[0_20px_50px_rgba(122,0,0,0.08)] sm:p-8"
>
  <div>
    <div class="flex items-start justify-between gap-5">
      <div
        class="grid size-14 place-items-center rounded-full border border-cidepac-700/20 bg-[#faf6f3] text-cidepac-700 transition duration-300 group-hover:border-cidepac-700 group-hover:bg-cidepac-700 group-hover:text-white"
        aria-hidden="true"
      >
        <svg
          width="25"
          height="25"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          set:html={icons[icon]}
        />
      </div>

      <span
        class="font-display text-xl text-cidepac-700"
        aria-hidden="true"
      >
        {number}
      </span>
    </div>

    <h2
      class="display-title mt-9 text-[2rem] leading-[0.98] text-neutral-950 transition-colors group-hover:text-cidepac-700"
    >
      {title}
    </h2>

    <p class="mt-5 text-sm leading-7 text-neutral-600">
      {description}
    </p>
  </div>

  <div
    class="mt-10 flex items-center justify-between gap-5 border-t border-[#eaded9] pt-5"
  >
    <p
      class="text-[0.65rem] font-extrabold uppercase tracking-[0.13em] text-neutral-400 transition-colors group-hover:text-cidepac-700"
    >
      Conoce la comisión
    </p>

    <span
      class="grid size-10 place-items-center rounded-full border border-[#eaded9] text-cidepac-700 transition duration-200 group-hover:border-cidepac-700 group-hover:bg-cidepac-700 group-hover:text-white"
      aria-hidden="true"
    >
      →
    </span>
  </div>
</article>