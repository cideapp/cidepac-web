<section class="relative overflow-hidden">
  <!-- decoración -->
  <div
    class="pointer-events-none absolute right-[-80px] top-16 size-64 rounded-full bg-cidepac-orange/8"
    aria-hidden="true"
  >
  </div>

  <div
    class="pointer-events-none absolute left-[-120px] top-72 size-56 rounded-full bg-cidepac-700/5"
    aria-hidden="true"
  >
  </div>

  <div
    class="site-container grid min-h-[calc(100svh-78px)] items-center gap-14 py-14 lg:grid-cols-[0.88fr_1.12fr] lg:py-16"
  >
    <!-- Contenido -->
    <div class="relative z-10 max-w-[620px]">
      <span
        class="mb-5 inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-[0.18em] text-cidepac-700"
      >
        <span class="h-px w-8 bg-cidepac-700"></span>
        Universidad Nacional de Trujillo
      </span>

      <h1
        class="display-title text-[3.65rem] leading-[0.92] text-cidepac-700 sm:text-[4.8rem] lg:text-[5.35rem] xl:text-[6rem]"
      >
        Pensar.
        <br />

        Debatir.
        <br />

        <span class="text-cidepac-orange">
          Participar.
        </span>
      </h1>

      <p
        class="mt-7 max-w-[560px] text-[1rem] leading-7 text-neutral-700 sm:text-[1.05rem]"
      >
        Un espacio universitario para el estudio, la investigación y el
        diálogo sobre democracia, partidos políticos y cultura política.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href="/nosotros"
          class="focus-ring inline-flex min-h-12 items-center justify-center rounded-md bg-cidepac-700 px-7 text-sm font-bold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-cidepac-900"
        >
          Conoce CIDEPAC
        </a>

        <a
          href="/articulos"
          class="focus-ring inline-flex min-h-12 items-center justify-center gap-2 rounded-md border border-cidepac-700 px-7 text-sm font-bold text-cidepac-700 transition duration-200 hover:bg-cidepac-700 hover:text-white"
        >
          Explorar artículos

          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div
        class="mt-10 flex items-center gap-4 border-t border-[#eaded9] pt-6"
      >
        <div
          class="grid size-11 shrink-0 place-items-center rounded-full bg-[#f7ebe8] text-cidepac-700"
          aria-hidden="true"
        >
          <svg
            width="21"
            height="21"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path d="M3 21h18"></path>
            <path d="M5 21V8l7-4 7 4v13"></path>
            <path d="M9 21v-6h6v6"></path>
            <path d="M8 10h.01"></path>
            <path d="M12 10h.01"></path>
            <path d="M16 10h.01"></path>
          </svg>
        </div>

        <div>
          <p class="text-sm font-bold text-neutral-900">
            Universidad Nacional de Trujillo
          </p>

          <p class="mt-0.5 text-xs leading-5 text-neutral-600">
            Escuela de Ciencia Política y Gobernabilidad
          </p>
        </div>
      </div>
    </div>

    <!-- Composición visual -->
    <div class="relative mx-auto w-full max-w-[680px] lg:mx-0">
      <div
        class="absolute -right-8 top-5 size-36 rounded-t-full bg-cidepac-orange"
        aria-hidden="true"
      >
      </div>

      <div
        class="absolute -left-7 bottom-20 size-28 rounded-full bg-cidepac-700"
        aria-hidden="true"
      >
      </div>

      <div
        class="relative z-10 ml-auto aspect-[1.12/1] w-[92%] overflow-hidden rounded-[2rem] border border-[#eaded9] bg-[#f1eeee]"
      >
        <!-- Placeholder temporal -->
        <div
          class="absolute inset-0 grid place-items-center bg-[linear-gradient(135deg,#f7f2ef,#e7dfdc)]"
        >
          <div class="text-center">
            <svg
              class="mx-auto text-neutral-400"
              width="55"
              height="55"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              aria-hidden="true"
            >
              <rect x="3" y="4" width="18" height="16" rx="2"></rect>
              <circle cx="8.5" cy="9" r="1.5"></circle>
              <path d="m21 15-5-5L5 20"></path>
            </svg>

            <p
              class="mt-4 text-xs font-bold uppercase tracking-[0.18em] text-neutral-400"
            >
              Fotografía CIDEPAC
            </p>
          </div>
        </div>

        <!-- línea editorial -->
        <div
          class="absolute right-0 top-0 h-full w-2 bg-cidepac-orange"
          aria-hidden="true"
        >
        </div>
      </div>

      <!-- Badge -->
      <div
        class="relative z-20 -mt-14 ml-0 w-[88%] rounded-xl bg-cidepac-700 p-5 text-white shadow-[0_20px_60px_rgba(122,0,0,0.22)] sm:ml-5 sm:w-[70%] lg:-mt-16"
      >
        <div class="flex items-start gap-4">
          <div
            class="grid size-10 shrink-0 place-items-center rounded-lg border border-white/25 bg-white/10"
          >
            <svg
              width="21"
              height="21"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="16" rx="2"></rect>
              <path d="M16 3v4M8 3v4M3 10h18"></path>
            </svg>
          </div>

          <div>
            <p class="text-sm font-extrabold">
              Desde el 18 de enero de 2025
            </p>

            <p class="mt-1 text-xs leading-5 text-white/80">
              Construimos pensamiento crítico y participación ciudadana.
            </p>
          </div>
        </div>
      </div>

      <!-- patrón -->
      <div
        class="absolute -right-1 bottom-10 hidden grid-cols-4 gap-2 md:grid"
        aria-hidden="true"
      >
        {
          Array.from({ length: 20 }).map(() => (
            <span class="size-1.5 rounded-full bg-cidepac-700/25"></span>
          ))
        }
      </div>
    </div>
  </div>
</section>