---
const articles = [
  {
    category: "Democracia",
    title: "CIDEPAC: un nuevo espacio para pensar la democracia",
    author: "Carlos Yemeri Arón Herrera Alayo",
    featured: true,
  },
  {
    category: "Democracia",
    title: "Corrupción: la máscara oculta de la realidad en la democracia",
    author: "Luciana Milena Castillo Palacios",
    featured: false,
  },
  {
    category: "Ciudadanía",
    title: "La ciudadanía y la vida política",
    author: "Luciano Alberto Chuquihuara Tirado",
    featured: false,
  },
];
---

<section
  id="articulos"
  class="border-t border-[#eaded9] bg-white py-20 lg:py-24"
>
  <div class="site-container">
    <!-- Header -->
    <div
      class="mb-12 flex flex-col justify-between gap-8 md:flex-row md:items-end"
    >
      <div>
        <div class="mb-6 flex items-center gap-4">
          <span class="font-display text-xl text-cidepac-700">
            05
          </span>

          <span class="h-px w-7 bg-cidepac-700/40"></span>

          <span
            class="text-xs font-extrabold uppercase tracking-[0.16em] text-neutral-700"
          >
            Perspectivas CIDEPAC
          </span>
        </div>

        <h2
          class="display-title max-w-[700px] text-[3rem] leading-[0.95] text-neutral-950 sm:text-[3.8rem] lg:text-[4.5rem]"
        >
          Ideas para
          <span class="text-cidepac-700">seguir pensando.</span>
        </h2>
      </div>

      <a
        href="/articulos"
        class="focus-ring inline-flex w-fit items-center gap-2 rounded-sm text-sm font-extrabold text-cidepac-700 transition hover:gap-3"
      >
        Ver todos los artículos
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Grid -->
    <div class="grid gap-6 lg:grid-cols-[1.35fr_0.65fr]">

      <!-- Artículo principal -->
      <a
        href="/articulos/cidepac-un-nuevo-espacio-para-pensar-la-democracia"
        class="focus-ring group overflow-hidden border border-[#eaded9] bg-[#faf6f3]"
      >
        <article>
          <div
            class="relative aspect-[16/8.5] overflow-hidden bg-[#eee8e5]"
          >
            <div
              class="absolute inset-0 grid place-items-center bg-[linear-gradient(135deg,#f5efec,#e7dfdc)]"
            >
              <div class="text-center text-neutral-400">
                <svg
                  class="mx-auto"
                  width="48"
                  height="48"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.3"
                  aria-hidden="true"
                >
                  <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                  <circle cx="8.5" cy="9" r="1.5"></circle>
                  <path d="m21 15-5-5L5 20"></path>
                </svg>

                <p
                  class="mt-3 text-[0.65rem] font-extrabold uppercase tracking-[0.18em]"
                >
                  Portada del artículo
                </p>
              </div>
            </div>

            <div
              class="absolute bottom-0 left-0 h-2 w-full origin-left bg-cidepac-700 transition-transform duration-300 group-hover:scale-x-[0.98]"
            ></div>
          </div>

          <div class="p-7 sm:p-9">
            <p
              class="text-[0.7rem] font-extrabold uppercase tracking-[0.15em] text-cidepac-700"
            >
              {articles[0].category}
            </p>

            <h3
              class="display-title mt-4 max-w-[760px] text-[2.25rem] leading-[1.02] text-neutral-950 transition-colors duration-200 group-hover:text-cidepac-700 sm:text-[2.8rem]"
            >
              {articles[0].title}
            </h3>

            <div
              class="mt-7 flex items-center justify-between gap-5 border-t border-[#e5d9d4] pt-5"
            >
              <p class="text-sm font-semibold text-neutral-600">
                Por {articles[0].author}
              </p>

              <span
                class="grid size-10 shrink-0 place-items-center rounded-full border border-cidepac-700 text-cidepac-700 transition duration-200 group-hover:bg-cidepac-700 group-hover:text-white"
                aria-hidden="true"
              >
                →
              </span>
            </div>
          </div>
        </article>
      </a>

      <!-- Secundarios -->
      <div class="grid gap-6">
        {
          articles.slice(1).map((article) => (
            <a
              href="/articulos"
              class="focus-ring group grid overflow-hidden border border-[#eaded9] bg-white sm:grid-cols-[160px_1fr] lg:grid-cols-1"
            >
              <div
                class="relative min-h-[180px] overflow-hidden bg-[#eee8e5] lg:min-h-[190px]"
              >
                <div
                  class="absolute inset-0 grid place-items-center bg-[#f2edeb]"
                >
                  <svg
                    class="text-neutral-400"
                    width="38"
                    height="38"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                    aria-hidden="true"
                  >
                    <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                    <circle cx="8.5" cy="9" r="1.5"></circle>
                    <path d="m21 15-5-5L5 20"></path>
                  </svg>
                </div>

                <span
                  class="absolute right-0 top-0 size-8 bg-cidepac-orange"
                  aria-hidden="true"
                ></span>
              </div>

              <article class="flex flex-col justify-between p-6">
                <div>
                  <p
                    class="text-[0.66rem] font-extrabold uppercase tracking-[0.15em] text-cidepac-700"
                  >
                    {article.category}
                  </p>

                  <h3
                    class="display-title mt-3 text-[1.55rem] leading-[1.05] text-neutral-950 transition-colors duration-200 group-hover:text-cidepac-700"
                  >
                    {article.title}
                  </h3>
                </div>

                <p
                  class="mt-6 border-t border-[#eaded9] pt-4 text-xs font-semibold leading-5 text-neutral-500"
                >
                  Por {article.author}
                </p>
              </article>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>